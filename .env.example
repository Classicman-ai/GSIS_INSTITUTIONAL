# Required runtime configuration
GSIS_MT5_CONNECTOR_PATH=/absolute/path/to/MT5_UNIVERSAL_CONNECTOR
GSIS_SYMBOLS=YOUR_BROKER_SYMBOLS
GSIS_TIMEFRAMES=YOUR_BROKER_TIMEFRAMES
GSIS_LOOP_INTERVAL_SECONDS=YOUR_INTERVAL
GSIS_HISTORY_COUNT=YOUR_HISTORY_COUNT
GSIS_RISK_PER_TRADE=YOUR_RISK_FRACTION
GSIS_ATR_MULTIPLIER=YOUR_STOP_MULTIPLIER
GSIS_REWARD_MULTIPLE=YOUR_REWARD_MULTIPLE
GSIS_MINIMUM_SIGNAL_SCORE=YOUR_MINIMUM_SIGNAL_SCORE
GSIS_EXECUTION_ENABLED=false
GSIS_DATABASE_PATH=/absolute/path/to/GSIS_INSTITUTIONAL/database/gsis.db

# Optional Telegram delivery configuration
GSIS_TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
GSIS_TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
GSIS_TELEGRAM_EVENT_FILE=/absolute/path/to/GSIS_INSTITUTIONAL/data/history/trade_events.json
GSIS_TELEGRAM_DELIVERY_FILE=/absolute/path/to/GSIS_INSTITUTIONAL/data/transparency/telegram_delivery.json
GSIS_TELEGRAM_MEMORY_FILE=/absolute/path/to/GSIS_INSTITUTIONAL/data/transparency/telegram_memory.json
GSIS_TELEGRAM_TIMEOUT_SECONDS=YOUR_TELEGRAM_TIMEOUT
