import sys
import os

sys.path.append(
    os.path.dirname(os.path.abspath(__file__))
)

from intelligence_bridge import IntelligenceBridge
from auto_learning_loop import AutoLearningLoop
from trade_lifecycle_engine import TradeLifecycleEngine
from execution_control_engine import ExecutionControlEngine
from broker_execution_gate import BrokerExecutionGate
from trade_monitor_engine import TradeMonitorEngine


print("==============================")
print("GSIS MASTER ORCHESTRATOR v1.6 ONLINE")
print("==============================")
print("FULL PIPELINE + MONITOR INTEGRATION ACTIVE")
print("==============================")


class GSISMasterOrchestrator:


    def __init__(self):

        self.intelligence = IntelligenceBridge()

        self.learning = AutoLearningLoop()

        self.lifecycle = TradeLifecycleEngine()

        self.execution = ExecutionControlEngine()

        self.broker = BrokerExecutionGate()

        self.monitor = TradeMonitorEngine()



    def run_pipeline(self, signal):

        print("==============================")
        print("GSIS MASTER PIPELINE START")
        print("==============================")


        intelligence_result = self.intelligence.evaluate(

            signal["symbol"],

            signal["direction"]

        )


        print("INTELLIGENCE RESULT")
        print(intelligence_result)



        learning_result = self.learning.process_signal(

            signal["symbol"],

            signal["direction"],

            signal["entry"],

            signal["stop_loss"],

            signal["tp1"],

            signal["confidence"],

            signal["reasons"]

        )


        print("LEARNING RESULT")
        print(learning_result)



        trade_result = self.lifecycle.open_trade(

            signal["symbol"],

            signal["direction"],

            signal["entry"],

            signal["stop_loss"],

            signal["tp1"],

            signal["confidence"]

        )


        print("TRADE CREATED")
        print(trade_result)



        execution_result = self.execution.authorize_execution(

            trade_result

        )


        print("EXECUTION RESULT")
        print(execution_result)



        broker_result = self.broker.execute_order(

            execution_result

        )


        print("BROKER RESULT")
        print(broker_result)



        monitor_result = self.monitor.update_trade(

            trade_result["trade_id"],

            "RUNNING",

            signal["entry"],

            0

/        )


        print("MONITOR RESULT")
        print(monitor_result)



        final_result = {

            "status": "PIPELINE COMPLETE",

            "trade_id": trade_result["trade_id"],

            "execution_id": execution_result["execution_id"],

            "order_id": broker_result["order_id"],

            "monitor": monitor_result,

            "intelligence": intelligence_result,

            "learning": learning_result

        }


        print("==============================")
        print("GSIS MASTER RESULT")
        print("==============================")
        print(final_result)


        return final_result



if __name__ == "__main__":


    signal = {

        "symbol": "XAUUSD",

        "direction": "SELL",

        "entry": 2387.5,

        "stop_loss": 2387.8,

        "tp1": 2387.2,

        "confidence": 100,

        "reasons": [

            "LIQUIDITY SWEEP CONFIRMED",

            "BEARISH ORDER BLOCK",

            "BEARISH FVG",

            "BEARISH CHoCH"

        ]

    }


    engine = GSISMasterOrchestrator()


    engine.run_pipeline(signal)
